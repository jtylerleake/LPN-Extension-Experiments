# Top-level dependencies. Compile with scripts/compile_requirements.ps1
# (runs pip-compile inside Docker) into base.txt (locked, used by
# Dockerfile.dev) and colab.txt (same libs minus the torch pin, since Colab
# already ships a CUDA-matched torch build).

# --- ML core ---
torch

# --- science / numerics ---
numpy
pandas

# --- plotting ---
matplotlib
seaborn

# --- config / CLI ---
pydantic
pyyaml
tqdm

# --- dev tooling ---
ruff
pytest
pip-tools
